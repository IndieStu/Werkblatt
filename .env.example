# Produktionsbetrieb: Secrets nicht hier ablegen. Die Deployment-Plattform soll
# geschützte Secret-Dateien über die unterstützten *_FILE-Variablen einbinden.
# DJANGO_SECRET_KEY=only-for-local-development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=werkblatt.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://werkblatt.example.org
WERKBLATT_PUBLIC_BASE_URL=https://werkblatt.example.org
WERKBLATT_DEFAULT_ORGANIZATION=example
WERKBLATT_SOFTWARE_AUTHOR_LABEL=Timo Hecken
WERKBLATT_SOFTWARE_AUTHOR_URL=https://github.com/IndieStu
WERKBLATT_SOFTWARE_COLLABORATION_LABEL=Zircula e.V.
WERKBLATT_SOFTWARE_COLLABORATION_URL=https://zircula.org
WERKBLATT_HOSTING_PROVIDER_LABEL=

POSTGRES_DB=werkblatt
POSTGRES_USER=werkblatt
# POSTGRES_PASSWORD=only-for-local-development
POSTGRES_HOST=db
POSTGRES_PORT=5432

OIDC_DISCOVERY_URL=https://auth.example.org/application/o/werkblatt/.well-known/openid-configuration
OIDC_ISSUER=https://auth.example.org/application/o/werkblatt/
OIDC_CLIENT_ID=CHANGE_ME
# OIDC_CLIENT_SECRET=only-for-local-development
OIDC_ALLOWED_GROUPS=Werkblatt Admins,Werkblatt Users
OIDC_ADMIN_GROUPS=Werkblatt Admins

PRETIX_BASE_URL=https://pretix.eu
PRETIX_ORGANIZER=example
# PRETIX_API_TOKEN=only-for-local-development

# Optionaler externer PDF-Speicher. Ohne URL bleiben erzeugte PDFs im privaten Volume.
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
# WEBDAV_PASSWORD=only-for-local-development
WEBDAV_ROOT=Werkblatt
# hosted: nur öffentliche oder explizit erlaubte Hosts; self_hosted: interne Ziele erlaubt.
WEBDAV_TRUST_MODE=hosted
WEBDAV_ALLOWED_HOSTS=
