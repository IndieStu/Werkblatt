# Produktionsbetrieb: Secrets nicht hier ablegen. compose.vps.yaml liest sie aus
# /srv/zircula/werkblatt/secrets; direkte Werte dienen nur lokaler Entwicklung/CI.
# DJANGO_SECRET_KEY=only-for-local-development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=werkblatt.zircula.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://werkblatt.zircula.org
WERKBLATT_PUBLIC_BASE_URL=https://werkblatt.zircula.org
WERKBLATT_DEFAULT_ORGANIZATION=zircula
WERKBLATT_SOFTWARE_AUTHOR_URL=https://zircula.org
WERKBLATT_HOSTING_PROVIDER_LABEL=Hosted by Zircula e.V.

POSTGRES_DB=werkblatt
POSTGRES_USER=werkblatt
# POSTGRES_PASSWORD=only-for-local-development
POSTGRES_HOST=db
POSTGRES_PORT=5432

OIDC_DISCOVERY_URL=https://auth.zircula.org/application/o/werkblatt/.well-known/openid-configuration
OIDC_ISSUER=https://auth.zircula.org/application/o/werkblatt/
OIDC_CLIENT_ID=CHANGE_ME
# OIDC_CLIENT_SECRET=only-for-local-development
OIDC_ALLOWED_GROUPS=Werkblatt Admins,Werkblatt Users
OIDC_ADMIN_GROUPS=Werkblatt Admins

PRETIX_BASE_URL=https://www.pretix.eu
PRETIX_ORGANIZER=WERK
# PRETIX_API_TOKEN=only-for-local-development

# Optionaler externer PDF-Speicher. Ohne URL bleiben erzeugte PDFs im privaten Volume.
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
# WEBDAV_PASSWORD=only-for-local-development
WEBDAV_ROOT=Werkblatt
# hosted: nur öffentliche oder explizit erlaubte Hosts; self_hosted: interne Ziele erlaubt.
WEBDAV_TRUST_MODE=hosted
WEBDAV_ALLOWED_HOSTS=
